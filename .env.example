# mongodb atlas connection string (local dev: run `npm run db:dev` and use the uri below)
MONGODB_URI=mongodb://127.0.0.1:27027/bclearns?replicaSet=rs0

# random secret for signing sessions: `openssl rand -base64 32`
AUTH_SECRET=

# public url of the app (used in email links)
APP_URL=http://localhost:3000

# email via resend.com (without a key, emails are logged and skipped)
RESEND_API_KEY=
EMAIL_FROM="BCLearns <hello@yourdomain.com>"
EMAIL_REPLY_TO=hello@bclearns.com

# photo uploads (optional): cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# shared secret the render cron job sends to /api/cron/*
CRON_SECRET=

# first admin created by `npm run seed`
SEED_ADMIN_EMAIL=hello@bclearns.com
SEED_ADMIN_NAME=BCLearns Admin
SEED_ADMIN_PASSWORD=

# optional: shared starting password for tutor accounts created by the seed (random if blank)
SEED_TUTOR_PASSWORD=
